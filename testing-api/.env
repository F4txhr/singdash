# ============================================
# Singdash Testing API - Environment Variables
# Pure On-Demand Mode (No Database)
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3001

# Proxy Source URL (GitHub)
PROXY_SOURCE_URL=https://raw.githubusercontent.com/backup-heavenly-demons/gateway/refs/heads/main/kvProxyList.json

# Testing Configuration
TEST_TIMEOUT=5000        # Timeout per proxy test (milliseconds)
TEST_CONCURRENT=20       # Number of concurrent tests

# MaxMind GeoIP (Optional - for better ISP lookup)
# If not set, will use free ip-api.com fallback
MAXMIND_USER_ID=
MAXMIND_LICENSE_KEY=
