# Server Configuration
NODE_ENV=development
PORT=3001

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# MaxMind GeoIP (Optional - untuk ISP lookup)
# Download database dari https://www.maxmind.com/en/geolite2/signup
MAXMIND_USER_ID=your-user-id
MAXMIND_LICENSE_KEY=your-license-key

# Proxy Source URL
PROXY_SOURCE_URL=https://raw.githubusercontent.com/backup-heavenly-demons/gateway/refs/heads/main/kvProxyList.json

# Testing Configuration
TEST_TIMEOUT=5000
TEST_CONCURRENT=50

# Cron Schedule for Auto-refresh (every 6 hours)
# Format: minute hour day month weekday
PROXY_REFRESH_CRON="0 */6 * * *"
