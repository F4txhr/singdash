# Singdash VPN Platform - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Testing API Configuration
# ============================================

# Server port (default: 3001)
PORT=3001

# Environment (development or production)
NODE_ENV=production

# GitHub proxy sources (comma-separated URLs)
# Supported formats: CSV, JSON, Text (IP:PORT)
GITHUB_PROXY_SOURCES=https://github.com/FoolVPN-ID/Nautica/raw/main/proxyList.txt

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Optional: Custom Settings
# ============================================

# Max concurrent proxy tests (default: 50)
# MAX_CONCURRENT_TESTS=50

# Test timeout in milliseconds (default: 2000)
# TEST_TIMEOUT_MS=2000

# Log level: error, warn, info, debug (default: info)
# LOG_LEVEL=info

# ============================================
# Notes
# ============================================
# - Never commit .env file to version control
# - Add .env to .gitignore
# - Use different values for development vs production
# - Rotate keys periodically for security
